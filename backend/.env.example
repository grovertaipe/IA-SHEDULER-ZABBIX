# zabbix-ai-maintenance-v2 backend configuration (Req 18.3).
#
# Copy this file to `.env` and fill in the real values. Placeholders marked
# REEMPLAZAR_* MUST be replaced with your own secrets. No secret is ever baked
# into the image or committed to the repo (Req 18.4, 18.5) — `.env` is ignored
# by git and by the Docker build context.
#
# Every variable read by `config.py::AppConfig.from_env` is documented below,
# split into BASE (required to operate) and EXTENDED (cross-cutting v2 tuning,
# all with safe defaults).

# =====================================================================
# BASE — Zabbix
# =====================================================================

# Full JSON-RPC endpoint of your Zabbix API (Zabbix 7.2+).
ZABBIX_API_URL=http://localhost/zabbix/api_jsonrpc.php

# Zabbix API token (secret). REQUIRED.
ZABBIX_TOKEN=REEMPLAZAR_POR_TOKEN

# TLS verification for the OUTBOUND connection to the Zabbix API.
# Default true (secure). Set false ONLY if your Zabbix uses a self-signed
# certificate you cannot otherwise trust (relaxes verification, like
# Elasticsearch's ssl verification_mode=none). Prefer ZABBIX_CA_BUNDLE.
ZABBIX_VERIFY_TLS=true
# Optional: absolute path (inside the container) to a CA bundle (PEM) to verify
# the Zabbix certificate against a private/internal CA. When set, it takes
# precedence over ZABBIX_VERIFY_TLS. Mount it via a volume.
# ZABBIX_CA_BUNDLE=/certs/zabbix-ca.pem

# =====================================================================
# BASE — AI provider and models
# =====================================================================

# Primary AI provider: "gemini" | "openai" | "bedrock".
AI_PROVIDER=gemini

# --- Gemini (required when AI_PROVIDER=gemini) ---
GOOGLE_API_KEY=REEMPLAZAR_POR_API_KEY
GEMINI_MODEL=gemini-flash-lite-latest

# --- OpenAI (required when AI_PROVIDER=openai) ---
OPENAI_API_KEY=REEMPLAZAR_POR_API_KEY
OPENAI_MODEL=gpt-4o-mini

# --- Amazon Bedrock (required when AI_PROVIDER=bedrock) ---
# Model id (Converse API). Default: amazon.nova-lite-v1:0
BEDROCK_MODEL=amazon.nova-lite-v1:0
# AWS region where Bedrock + the model are enabled, e.g. us-east-1.
# REQUIRED even when using the Bedrock API key below.
AWS_REGION=us-east-1
# Bedrock API key (bearer token). RECOMMENDED for quick setups: when set, boto3
# uses it automatically and you do NOT need AWS_ACCESS_KEY_ID/SECRET.
AWS_BEARER_TOKEN_BEDROCK=
# Credentials: leave BLANK to use the default AWS credential chain
# (IAM role / instance profile / ~/.aws). Only set these for static keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# =====================================================================
# BASE — HTTP / CORS / version
# =====================================================================

# Comma-separated list of EXPLICIT allowed origins (never "*", Req 15.5).
CORS_ALLOWED_ORIGINS=http://localhost,https://zabbix.example.com

# Version reported by /health. OPTIONAL and normally left UNSET: the real
# version is injected AUTOMATICALLY at image build time from the git tag (via
# the Docker APP_VERSION build-arg set by CI), so /health reports the released
# version with no manual editing. Setting it here only OVERRIDES that baked
# value — it is an escape hatch, not the source of truth. The example value
# below is illustrative; leave it commented/unset in production so the
# image-baked version wins.
# APP_VERSION=2.5.1

# =====================================================================
# EXTENDED — Localization (Req 21)
# =====================================================================

# Comma-separated supported locales; "es" is always included. Default: es,en
SUPPORTED_LOCALES=es,en,pt

# Default locale used when the request locale is missing/unsupported. Coerced
# back to "es" if not in SUPPORTED_LOCALES. Default: es
DEFAULT_LOCALE=es

# =====================================================================
# EXTENDED — AI failover (Req 26)
# =====================================================================

# Optional secondary provider for failover: "gemini" | "openai" | "bedrock".
# Leave empty to disable failover. Provide its API key/model/AWS settings above
# as needed. For example, AI_SECONDARY_PROVIDER=bedrock enables Bedrock as the
# failover provider behind the primary.
AI_SECONDARY_PROVIDER=

# Bounded retries against the primary before switching. Default: 1
AI_FAILOVER_MAX_RETRIES=1

# Per-attempt time budget in seconds. Default: 30
AI_FAILOVER_TIMEOUT_SECONDS=30

# Per-attempt NETWORK timeout (seconds) for a single provider SDK call. Applied
# at the SDK/transport layer so a hung network read raises promptly instead of
# stalling the worker. MUST be LESS than the gunicorn worker --timeout
# (currently 120s) so a hung call fails before the worker is killed. Default: 20
AI_REQUEST_TIMEOUT_SECONDS=20

# =====================================================================
# EXTENDED — User-validation cache (Req 27)
# =====================================================================

# TTL in seconds for cached Zabbix user validations. Default: 300
USER_CACHE_TTL_SECONDS=300

# =====================================================================
# EXTENDED — Rate limiting (Req 28)
# =====================================================================

# Max requests allowed per window. Default: 60
RATE_LIMIT_MAX_REQUESTS=60

# Rate-limit window size in seconds. Default: 60
RATE_LIMIT_WINDOW_SECONDS=60

# =====================================================================
# EXTENDED — AI-schema validation (Req 29)
# =====================================================================

# Max validation attempts before failing an AI extraction. Default: 2
AI_SCHEMA_MAX_ATTEMPTS=2
