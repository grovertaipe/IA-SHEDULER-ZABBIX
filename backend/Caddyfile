# Caddyfile — inbound TLS reverse proxy for the AI Maintenance Assistant.
#
# Caddy terminates HTTPS for the browser/widget and forwards plain HTTP to the
# backend on the internal Docker network. There are THREE modes; the default
# works with ZERO manual steps (no domain, no external certificate), the
# Elasticsearch/Kibana pattern: HTTPS is on by default, the browser warns once
# (open the backend URL directly and accept the exception).
#
# ---------------------------------------------------------------------------
# MODE 1 (DEFAULT) — auto self-signed for your IP/FQDN (no FQDN, no external cert).
# ---------------------------------------------------------------------------
# Active below. This REPLACES the old `tls internal` approach (Caddy's internal
# CA could not present a cert for a bare IP with no SNI, so IP-only handshakes
# failed). Instead the `caddy_init` service mints a self-signed certificate that
# covers the IPs/FQDNs in AIMA_TLS_HOSTS (plus loopback), and Caddy serves it
# via explicit `tls /certs/backend.crt /certs/backend.key`. HTTP/3 (QUIC) is
# disabled (`protocols h1 h2`) so bare-IP handshakes stay deterministic.
# Reach the backend at https://<host> (port 443); the browser warns once —
# open the URL directly and accept the exception, then the widget works.

{
	# Disable the automatic HTTP->HTTPS redirect so a plain http://<host> probe
	# still reaches the proxy predictably. For a real domain (MODE 3) you can
	# remove this line to get the usual redirect behaviour.
	auto_https disable_redirects
	servers {
		# Restrict to HTTP/1.1 + HTTP/2; disable HTTP/3/QUIC, which is
		# unreliable for bare-IP access (and triggers a UDP buffer warning).
		protocols h1 h2
	}
}

:443 {
	# Serve the self-signed cert generated by caddy_init from AIMA_TLS_HOSTS.
	# Delete the ./certs directory and restart to force regeneration.
	tls /certs/backend.crt /certs/backend.key

	# Reverse-proxy to ONE backend instance by its Docker service name. To scale
	# out later, point this at a load balancer or list multiple upstreams, e.g.
	#   reverse_proxy aima1:5005 aima2:5005 aima3:5005
	reverse_proxy aima1:5005
}

# ---------------------------------------------------------------------------
# MODE 2 — bring your own certificate (production without a public ACME setup).
# ---------------------------------------------------------------------------
# Drop your own cert/key into the ./certs bind mount (already mounted read-only
# at /certs) and point `tls` at them instead of the auto-generated pair:
#
# :443 {
#     tls /certs/fullchain.pem /certs/privkey.pem
#     reverse_proxy aima1:5005
# }

# ---------------------------------------------------------------------------
# MODE 3 — real domain with automatic Let's Encrypt (ACME) certificates.
# ---------------------------------------------------------------------------
# Requires a PUBLIC FQDN pointing at this host and ports 80/443 reachable from
# the internet. Replace the whole `:443 { ... }` block above with your domain
# and drop the explicit `tls` line — Caddy auto-provisions and renews the cert:
#
# your.domain.com {
#     reverse_proxy aima1:5005
# }
